# The official Makefile points DUCKFLIGHT_CORE_PATH at the open mock core for tests.
require duckflight

query TT
select loaded::varchar, abi_version::varchar from duckflight_core_status();
----
true	1

query TT
select * from duckflight_servers();
----

statement error
select * from duckflight_adbc_serve('127.0.0.1:0', '');
----
does not exist

statement error
select * from duckflight_stop('adbc', '127.0.0.1:15051');
----
unsupported DuckFlight extension protocol

query TT
select * from duckflight_pg_serve('127.0.0.1:0', '');
----
pgwire	127.0.0.1:15432

query TT
select * from duckflight_flight_serve('127.0.0.1:0', '');
----
flight	127.0.0.1:15051

query TT
select * from duckflight_http_serve('127.0.0.1:0', '');
----
http	127.0.0.1:18080

query TT
select * from duckflight_quack_serve('127.0.0.1:0', '');
----
quack	127.0.0.1:18081

query TT rowsort
select * from duckflight_servers();
----
flight	127.0.0.1:15051
http	127.0.0.1:18080
pgwire	127.0.0.1:15432
quack	127.0.0.1:18081

query T
select * from duckflight_stop('postgresql', '127.0.0.1:15432');
----
stopped pgwire server on 127.0.0.1:15432

query T
select * from duckflight_stop('flight', '127.0.0.1:15051');
----
stopped flight server on 127.0.0.1:15051

query T
select * from duckflight_stop(' HTTP ', '127.0.0.1:18080');
----
stopped http server on 127.0.0.1:18080

query TT
select * from duckflight_servers();
----
quack	127.0.0.1:18081

query T
select * from duckflight_stop('QuAcK', '127.0.0.1:18081');
----
stopped quack server on 127.0.0.1:18081

query T
select * from duckflight_stop('http', '127.0.0.1:18080');
----
no http server on 127.0.0.1:18080

query T
select * from duckflight_stop('quack', '127.0.0.1:18081');
----
no quack server on 127.0.0.1:18081

query TT
select * from duckflight_servers();
----
